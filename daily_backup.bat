@echo off
powershell.exe -NoProfile -ExecutionPolicy Bypass -Command "$backupDir = 'D:\posweb2\backups'; $db = 'D:\posweb2\bot_backend\pos.db'; $date = Get-Date -Format 'yyyy-MM-dd'; $dest = Join-Path $backupDir \"pos_backup_$date.sqlite\"; $log = Join-Path $backupDir 'backup.log'; if (Test-Path $db) { Copy-Item $db $dest -Force; \"[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] Backup thanh cong: $dest\" | Out-File $log -Append; Write-Host \"[POS Backup] Da sao luu pos.db thanh: $dest\"; Get-ChildItem $backupDir -Filter 'pos_backup_*.sqlite' | Where-Object { $_.LastWriteTime -lt (Get-Date).AddDays(-30) } | Remove-Item -Force } else { \"[$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')] ERROR: Khong tim thay $db\" | Out-File $log -Append; Write-Host \"[POS Backup] Loi: Khong tim thay $db\" }"
